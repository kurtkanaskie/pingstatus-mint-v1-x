<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault async="false" continueOnError="false" enabled="true" name="RF-path-suffix-not-found">
  <!-- Should never get here since API Product explicitly lists operations, but just in case. -->
  <FaultResponse>
    <Set>
      <Headers/>
      <Payload contentType="text/plain">Resource not found at {proxy.pathsuffix}</Payload>
      <StatusCode>404</StatusCode>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
